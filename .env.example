VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WHATSAPP_NUMBER=573181749436

# Solo en desarrollo: replica la clave en el navegador para poder firmar la
# llamada a `api/zernio/enviar`. En Vercel NO se define: ahi la firma la hace el
# servidor, que ya tiene ZERNIO_API_KEY.
VITE_ZERNIO_API_KEY=

# ------------------------------------------------------------
# Solo servidor (Vercel Environment Variables). Ninguna lleva prefijo VITE_,
# porque Vite mete en el bundle del navegador todo lo que empiece por VITE_.
# ------------------------------------------------------------
# ZERNIO_API_KEY=sk_...
# ZERNIO_WEBHOOK_SECRET=...        el que vos inventes al registrar el webhook
# SUPABASE_URL=...                 mismo project ref de arriba
# SUPABASE_SERVICE_ROLE_KEY=...    service role, solo la usa el webhook
# ZERNIO_OBSERVE=1                 1 = el webhook solo mira y no escribe nada.
#                                  Poner 0 para que empiece a guardar en la bandeja.
# ZERNIO_BASE_URL=https://api.zernio.com
# ZERNIO_SEND_PATH=/v1/inbox/messages

# GOOGLE_APPS_SCRIPT_URL y GOOGLE_APPS_SCRIPT_SECRET se configuran únicamente
# en Supabase Edge Function Secrets; no son variables del frontend.
WHATSAPP_NUMBERS=3102318786,3016303982